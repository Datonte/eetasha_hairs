{
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/:page(shop|about|account|admin|checkout|checkout-success|delivery|returns).html", "destination": "/:page", "permanent": true }
  ],
  "rewrites": [
    { "source": "/:page(shop|about|account|admin|checkout|checkout-success|delivery|returns)", "destination": "/:page.html" },
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/product/:slug", "destination": "/api/index" },
    { "source": "/sitemap.xml", "destination": "/api/index" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
