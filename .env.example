# Copy this file to .env for local development.
# In production, set these in Vercel → Project → Settings → Environment Variables.
# NEVER commit real values.

# --- Supabase (Dashboard → Project Settings → API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY
# Service role key is server-only: never put it in front-end code
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY

# --- Admin ---
# REQUIRED in production, 32+ random characters. Admin login is disabled without it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Only used to create the first admin account when none exists (12+ characters).
# Remove it once the account is created.
ADMIN_INITIAL_PASSWORD=

# --- Stripe (https://dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY

# --- Email (https://resend.com/api-keys) ---
RESEND_API_KEY=

# --- Site ---
PUBLIC_SITE_URL=https://eetashacollection.com
PORT=3000
